{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node bake-metrics.mjs . ; rm -f vercel.json bake-metrics.mjs && if find . -name '*.md' | grep .; then echo 'a Markdown file would be published' >&2; exit 1; fi",
  "outputDirectory": ".",
  "trailingSlash": true,
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- .",
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "versorium-landing-page.vercel.app" }], "destination": "https://versorium.maecly.com/$1", "permanent": true }
  ]
}
